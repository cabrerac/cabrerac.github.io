# Auto detect text files and perform LF normalization
* text=auto

# Force specific files to use LF
*.md text eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mp3 binary
*.wav binary 